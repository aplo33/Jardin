// **************************************************************************
// TypeAdapterGenerator
// **************************************************************************

class PlantAdapter extends TypeAdapter<Plant> {
  @override
  final int typeId = 0;

  @override
  Plant read(BinaryReader reader) {
    final numOfFields = reader.readByte();
    final fields = <int, dynamic>{
      for (int i = 0; i < numOfFields; i++) reader.readByte(): reader.read(),
    };
    return Plant(
      id: fields[0] as String,
      name: fields[1] as String,
      scientificName: fields[2] as String?,
      description: fields[3] as String?,
      type: fields[4] as PlantType,
      categories: (fields[5] as List).cast<PlantCategory>(),
      imagePath: fields[6] as String?,
      plantingDate: fields[7] as DateTime?,
      harvestDate: fields[8] as DateTime?,
      daysToMaturity: fields[9] as int?,
      sunExposure: fields[10] as SunExposure,
      waterNeed: fields[11] as WaterNeed,
      soilType: fields[12] as SoilType,
      idealPh: fields[13] as double?,
      spacing: fields[14] as double?,
      depth: fields[15] as double?,
      companionPlants: fields[16] as String?,
      avoidPlants: fields[17] as String?,
      careInstructions: fields[18] as String?,
      harvestInstructions: fields[19] as String?,
      isFavorite: fields[20] as bool,
      isActive: fields[21] as bool,
      createdAt: fields[22] as DateTime?,
      updatedAt: fields[23] as DateTime?,
      gardenId: fields[24] as String?,
    );
  }

  @override
  void write(BinaryWriter writer, Plant obj) {
    writer
      ..writeByte(25)
      ..writeByte(0)
      ..write(obj.id)
      ..writeByte(1)
      ..write(obj.name)
      ..writeByte(2)
      ..write(obj.scientificName)
      ..writeByte(3)
      ..write(obj.description)
      ..writeByte(4)
      ..write(obj.type)
      ..writeByte(5)
      ..write(obj.categories)
      ..writeByte(6)
      ..write(obj.imagePath)
      ..writeByte(7)
      ..write(obj.plantingDate)
      ..writeByte(8)
      ..write(obj.harvestDate)
      ..writeByte(9)
      ..write(obj.daysToMaturity)
      ..writeByte(10)
      ..write(obj.sunExposure)
      ..writeByte(11)
      ..write(obj.waterNeed)
      ..writeByte(12)
      ..write(obj.soilType)
      ..writeByte(13)
      ..write(obj.idealPh)
      ..writeByte(14)
      ..write(obj.spacing)
      ..writeByte(15)
      ..write(obj.depth)
      ..writeByte(16)
      ..write(obj.companionPlants)
      ..writeByte(17)
      ..write(obj.avoidPlants)
      ..writeByte(18)
      ..write(obj.careInstructions)
      ..writeByte(19)
      ..write(obj.harvestInstructions)
      ..writeByte(20)
      ..write(obj.isFavorite)
      ..writeByte(21)
      ..write(obj.isActive)
      ..writeByte(22)
      ..write(obj.createdAt)
      ..writeByte(23)
      ..write(obj.updatedAt)
      ..writeByte(24)
      ..write(obj.gardenId);
  }

  @override
  int get hashCode => typeId.hashCode;

  @override
  bool operator ==(Object other) =>
      identical(this, other) ||
      other is PlantAdapter &&
          runtimeType == other.runtimeType &&
          typeId == other.typeId;
}
