// **************************************************************************
// TypeAdapterGenerator
// **************************************************************************

class HarvestAdapter extends TypeAdapter<Harvest> {
  @override
  final int typeId = 2;

  @override
  Harvest read(BinaryReader reader) {
    final numOfFields = reader.readByte();
    final fields = <int, dynamic>{
      for (int i = 0; i < numOfFields; i++) reader.readByte(): reader.read(),
    };
    return Harvest(
      id: fields[0] as String,
      plantId: fields[1] as String,
      plantName: fields[2] as String,
      harvestDate: fields[3] as DateTime,
      quantity: fields[4] as double,
      unit: fields[5] as String,
      notes: fields[6] as String?,
      quality: fields[7] as String?,
      imagePath: fields[8] as String?,
      gardenId: fields[9] as String?,
      createdAt: fields[10] as DateTime?,
      updatedAt: fields[11] as DateTime?,
    );
  }

  @override
  void write(BinaryWriter writer, Harvest obj) {
    writer
      ..writeByte(12)
      ..writeByte(0)
      ..write(obj.id)
      ..writeByte(1)
      ..write(obj.plantId)
      ..writeByte(2)
      ..write(obj.plantName)
      ..writeByte(3)
      ..write(obj.harvestDate)
      ..writeByte(4)
      ..write(obj.quantity)
      ..writeByte(5)
      ..write(obj.unit)
      ..writeByte(6)
      ..write(obj.notes)
      ..writeByte(7)
      ..write(obj.quality)
      ..writeByte(8)
      ..write(obj.imagePath)
      ..writeByte(9)
      ..write(obj.gardenId)
      ..writeByte(10)
      ..write(obj.createdAt)
      ..writeByte(11)
      ..write(obj.updatedAt);
  }

  @override
  int get hashCode => typeId.hashCode;

  @override
  bool operator ==(Object other) =>
      identical(this, other) ||
      other is HarvestAdapter &&
          runtimeType == other.runtimeType &&
          typeId == other.typeId;
}
